# Set ONE TMDB credential. Keep these server-side; do not use NEXT_PUBLIC_.
TMDB_API_READ_ACCESS_TOKEN=
# Alternatively, use a TMDB v3 API key:
TMDB_API_KEY=

# Existing request-management admin credentials:
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Private viewer access. Generate these with: node scripts/add-viewer.cjs username
AUTH_SESSION_SECRET=
VIEWER_ACCOUNTS=[]
